# Optional bootstrap overrides. The web setup UI is the recommended configuration method.
MRWB_HOST=127.0.0.1
MRWB_PORT=8787
MRWB_DATA_DIR=./data
MRWB_LOG_LEVEL=INFO
MRWB_OPEN_BROWSER=true

# Proxy for api.telegram.org. Set this when Telegram is unreachable directly and
# the bot fails to start with a connect timeout. HTTPS_PROXY/ALL_PROXY also work.
# Examples: http://127.0.0.1:8080 or socks5h://127.0.0.1:1080
# MRWB_TELEGRAM_PROXY=
